# CMake build directories
build/
build_*/
cov_build/

# Compiled object files
*.o
*.a
*.so
*.dylib
*.dll

# Executables
*.out
*.exe

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
Testing/

# Coverage reports
coverage-report/
*.gcda
*.gcno
*.lcov
*.info

# Compiler / linker artifacts
*.d
*.dSYM/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Local dependency paths (see smc/peripherals/uart/deps.env.example)
smc/peripherals/uart/deps.env

# Local dependency paths (see smc/peripherals/cpu_ctrl/deps.env.example)
smc/peripherals/cpu_ctrl/deps.env

# Local dependency paths (see smc/cpu_cluster/deps.env.example)
smc/cpu_cluster/deps.env

# Local dependency paths (see smc/peripherals/memory_zeroer/deps.env.example)
smc/peripherals/memory_zeroer/deps.env

# Local dependency paths (see sep/peripherals/deps.env.example)
sep/peripherals/deps.env

# clangd / Microsoft C/C++ language-server caches — auto-generated, per-user.
.cache/
.ccls-cache/

# compile_commands.json symlinks pointing into build/ — recreated by the
# build (see CMake's CMAKE_EXPORT_COMPILE_COMMANDS).
**/peripherals/*/compile_commands.json
smc/platform/compile_commands.json

# LLVM source-based coverage raw profiles (run_tests.sh --coverage).
**/*.profraw

# macOS
.DS_Store




# SEP files to be ignored by git 

# =============================================================================
# Tenstorrent SEP (SystemC Execution Platform) - Root .gitignore
# =============================================================================
# This file applies to all models in the repository (HMAC, OTBN, GPIO, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# CMake Build Directories (all models)
# -----------------------------------------------------------------------------
**/build/
**/build-*/
**/build_*/
**/cov_build/

# -----------------------------------------------------------------------------
# Legacy Makefile Build Directories
# -----------------------------------------------------------------------------
**/Obj/
**/obj/
**/obj_nocci/
**/bin/
# Exception: firmware standalone scripts in tt-oca-hw-main/bin/ must be tracked
!sw/tt-oca-hw-main/bin
**/lib/

# -----------------------------------------------------------------------------
# Compiled Object Files
# -----------------------------------------------------------------------------
**/*.o
**/*.a
**/*.so
**/*.so.*
**/*.dylib
**/*.dll
**/*.exe
**/*.dump

# -----------------------------------------------------------------------------
# Executables
# -----------------------------------------------------------------------------
**/*.x
**/*.out
**/sim.x
**/a.out

# -----------------------------------------------------------------------------
# Debug Files
# -----------------------------------------------------------------------------
**/*.dSYM/
**/*.su
**/*.idb
**/*.pdb
**/Debug_Log.txt

# -----------------------------------------------------------------------------
# Code Coverage Files
# -----------------------------------------------------------------------------
**/*.gcov
**/*.gcda
**/*.gcno
**/*.gcov.json
**/coverage.info
**/filtered_coverage.info
**/coverage_filtered.info
**/coverage/
**/htmlcov/
**/.coverage

# -----------------------------------------------------------------------------
# Static Analysis
# -----------------------------------------------------------------------------
**/cppcheck_results/
**/cppcheck_report.txt

# -----------------------------------------------------------------------------
# Documentation Generated Files
# -----------------------------------------------------------------------------
**/docs/html/
**/docs/latex/
**/*-generated-docs/html/
**/*-generated-docs/latex/

# -----------------------------------------------------------------------------
# SystemC Simulation Files
# -----------------------------------------------------------------------------
**/*.wif
**/*.vcd
**/*.fst
**/*.ghw

# -----------------------------------------------------------------------------
# Dependency Files
# -----------------------------------------------------------------------------
**/*.d
**/.deps/

# -----------------------------------------------------------------------------
# CMake Generated Files
# -----------------------------------------------------------------------------
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/CTestTestfile.cmake
**/*.cmake
!**/CMakeLists.txt
!**/*.cmake.in
!**/cmake/*.cmake

# -----------------------------------------------------------------------------
# Editor and IDE Files
# -----------------------------------------------------------------------------
# VSCode
**/.vscode/
**/*.code-workspace

# CLion / IntelliJ
**/.idea/
**/*.iml

# Eclipse
**/.project
**/.cproject
**/.settings/
**/.metadata/

# Vim
**/*~
**/*.swp
**/*.swo
**/.*.sw*
**/*.un~

# Emacs
**/*#
**/.#*

# Sublime Text
**/*.sublime-project
**/*.sublime-workspace

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*

# Windows
**/Thumbs.db
**/Desktop.ini
**/[Dd]esktop.ini
**/$RECYCLE.BIN/

# Linux
**/.directory
**/.Trash-*/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
**/tmp/
**/temp/
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.cache

# -----------------------------------------------------------------------------
# Python (if any Python scripts are used)
# -----------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.egg-info/

# -----------------------------------------------------------------------------
# Log Files
# -----------------------------------------------------------------------------
**/*.log
**/logs/

# -----------------------------------------------------------------------------
# Package Manager Files
# -----------------------------------------------------------------------------
**/node_modules/
**/package-lock.json

# -----------------------------------------------------------------------------
# Backup and Archive Files
# -----------------------------------------------------------------------------
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.rar
**/*.7z


#------------------------------------------------------------------------------
# Exception for softfloat source build files (Makefile + platform.h only)
#------------------------------------------------------------------------------
!sep/cpu/VeeR-ISS/softfloat/build
!sep/cpu/VeeR-ISS/softfloat/build/**/
!sep/cpu/VeeR-ISS/softfloat/build/**/Makefile
!sep/cpu/VeeR-ISS/softfloat/build/**/platform.h

# -----------------------------------------------------------------------------
# Local-only doc tooling: stylesheets are developer helpers
# (print stylesheets) and are intentionally not tracked.
# CPU cluster IP docs under smc/cpu_cluster/doc/ are tracked (01/02/03 layout).
# cpu_ctrl follows the same doc convention (see smc/peripherals/cpu_ctrl/doc/).
*.css
**/*.css
!smc/cpu_cluster/doc/
!smc/cpu_cluster/doc/**
!smc/peripherals/cpu_ctrl/doc/
!smc/peripherals/cpu_ctrl/doc/**

#*.md 
*.svg
!smc/cpu_cluster/doc/
!smc/cpu_cluster/doc/**
!smc/peripherals/cpu_ctrl/doc/
!smc/peripherals/cpu_ctrl/doc/**
!smc/peripherals/cpu_ctrl/README.md

# OCH GitHub Pages documentation is intentionally tracked under docs/och.
!docs/
!docs/**
docs/och_source/_build/

# ======================================================================================

# =============================================================================
# SMC VP firmware test build artifacts
# Each smc-*-test directory produces a binary with the same name as the test.
# =============================================================================
sw/smc-vp-tests/smc-*-test/smc-*-test
sw/smc-vp-tests/smc-*-test/*.o
sw/smc-vp-tests/smc-*-test/*.log

# =============================================================================
# End of .gitignore
# =============================================================================

