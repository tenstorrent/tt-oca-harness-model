# CMake build directories
build/
build_*/
cov_build/

# Compiled object files
*.o
*.a
*.so
*.dylib
*.dll

# Executables
*.out
*.exe

# CMake generated files.  NOTE: no bare "Makefile" entry here -- an unscoped
# "Makefile" pattern matches ANY file named exactly "Makefile" anywhere in the
# repo (git .gitignore patterns with no "/" match at every depth), which
# silently swallows hand-written Makefiles too (e.g. sw/smc-vp-tests/*/Makefile,
# sw/sep-vp-tests/*/Makefile).  CMake's generated Makefile always lands inside
# a build directory, which is already covered by the build/ / build_*/ /
# cov_build/ patterns above -- a separate bare "Makefile" line is both
# redundant for its intended purpose and actively harmful for everything else.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Coverage reports
coverage-report/
*.gcda
*.gcno
*.lcov
*.info

# Compiler / linker artifacts
*.d
*.dSYM/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Local dependency paths (see smc/peripherals/*/deps.env.example)
smc/peripherals/uart/deps.env
smc/peripherals/beu/deps.env
smc/peripherals/avsbus_controller/deps.env

# Local dependency paths (see smc/peripherals/cpu_ctrl/deps.env.example)
smc/peripherals/cpu_ctrl/deps.env

# Local dependency paths (see smc/cpu_cluster/deps.env.example)
smc/cpu_cluster/deps.env

# Local dependency paths (see smc/peripherals/memory_zeroer/deps.env.example)
smc/peripherals/memory_zeroer/deps.env

# Local dependency paths (see sep/peripherals/deps.env.example)
sep/peripherals/deps.env

# Local dependency paths (see aou/deps.env.example)
aou/deps.env
aou/compile_commands.json

# clangd / Microsoft C/C++ language-server caches — auto-generated, per-user.
.cache/
.ccls-cache/

# compile_commands.json symlinks pointing into build/ — recreated by the
# build (see CMake's CMAKE_EXPORT_COMPILE_COMMANDS).
**/peripherals/*/compile_commands.json
smc/platform/compile_commands.json

# LLVM source-based coverage raw profiles (run_tests.sh --coverage).
**/*.profraw

# Generated documentation PDFs. Rebuild locally with scripts/build_docs.sh;
# do not commit them.
*.pdf

# macOS
.DS_Store




# SEP files to be ignored by git 

# =============================================================================
# Tenstorrent SEP (SystemC Execution Platform) - Root .gitignore
# =============================================================================
# This file applies to all models in the repository (HMAC, OTBN, KMAC, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# CMake Build Directories (all models)
# -----------------------------------------------------------------------------
**/build/
**/build-*/
**/build_*/
**/cov_build/

# -----------------------------------------------------------------------------
# Legacy Makefile Build Directories
# -----------------------------------------------------------------------------
**/Obj/
**/obj/
**/obj_nocci/
**/bin/
**/lib/

# -----------------------------------------------------------------------------
# Compiled Object Files
# -----------------------------------------------------------------------------
**/*.o
**/*.a
**/*.so
**/*.so.*
**/*.dylib
**/*.dll
**/*.exe
**/*.dump
**/*.crt0.cpp.s

# -----------------------------------------------------------------------------
# Executables
# -----------------------------------------------------------------------------
**/*.x
**/*.out
**/sim.x
**/a.out

# -----------------------------------------------------------------------------
# Debug Files
# -----------------------------------------------------------------------------
**/*.dSYM/
**/*.su
**/*.idb
**/*.pdb
**/Debug_Log.txt

# -----------------------------------------------------------------------------
# Code Coverage Files
# -----------------------------------------------------------------------------
**/*.gcov
**/*.gcda
**/*.gcno
**/*.gcov.json
**/coverage.info
**/filtered_coverage.info
**/coverage_filtered.info
**/coverage/
**/htmlcov/
**/.coverage

# -----------------------------------------------------------------------------
# Static Analysis
# -----------------------------------------------------------------------------
**/cppcheck_results/
**/cppcheck_report.txt

# -----------------------------------------------------------------------------
# Documentation Generated Files
# -----------------------------------------------------------------------------
**/docs/html/
**/docs/latex/
**/*-generated-docs/html/
**/*-generated-docs/latex/

# -----------------------------------------------------------------------------
# SystemC Simulation Files
# -----------------------------------------------------------------------------
**/*.wif
**/*.vcd
**/*.fst
**/*.ghw

# -----------------------------------------------------------------------------
# Dependency Files
# -----------------------------------------------------------------------------
**/*.d
**/.deps/

# -----------------------------------------------------------------------------
# CMake Generated Files
# -----------------------------------------------------------------------------
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/CTestTestfile.cmake
**/*.cmake
!**/CMakeLists.txt
!**/*.cmake.in
!**/cmake/*.cmake

# -----------------------------------------------------------------------------
# Editor and IDE Files
# -----------------------------------------------------------------------------
# VSCode
**/.vscode/
**/*.code-workspace

# CLion / IntelliJ
**/.idea/
**/*.iml

# Eclipse
**/.project
**/.cproject
**/.settings/
**/.metadata/

# Vim
**/*~
**/*.swp
**/*.swo
**/.*.sw*
**/*.un~

# Emacs
**/*#
**/.#*

# Sublime Text
**/*.sublime-project
**/*.sublime-workspace

# -----------------------------------------------------------------------------
# OS Generated Files
# -----------------------------------------------------------------------------
# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*

# Windows
**/Thumbs.db
**/Desktop.ini
**/[Dd]esktop.ini
**/$RECYCLE.BIN/

# Linux
**/.directory
**/.Trash-*/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
**/tmp/
**/temp/
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.cache

# -----------------------------------------------------------------------------
# Python (if any Python scripts are used)
# -----------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/*.egg-info/

# -----------------------------------------------------------------------------
# Log Files
# -----------------------------------------------------------------------------
**/*.log
**/logs/

# -----------------------------------------------------------------------------
# Package Manager Files
# -----------------------------------------------------------------------------
**/node_modules/
**/package-lock.json

# -----------------------------------------------------------------------------
# Backup and Archive Files
# -----------------------------------------------------------------------------
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.rar
**/*.7z


#------------------------------------------------------------------------------
# Exception for softfloat source build files (Makefile + platform.h only)
#------------------------------------------------------------------------------
!sep/cpu/VeeR-ISS/softfloat/build
!sep/cpu/VeeR-ISS/softfloat/build/**/
!sep/cpu/VeeR-ISS/softfloat/build/**/Makefile
!sep/cpu/VeeR-ISS/softfloat/build/**/platform.h

# -----------------------------------------------------------------------------
# Local-only doc tooling: print stylesheets and generated figures
# are developer helpers and are not tracked.
*.css
**/*.css

*.svg

# Legacy peripheral Markdown (01/02/03 specs and OpenTitan copies).
# Canonical pages are AsciiDoc: doc/{index,implementation,test_plan}.adoc.
# These .md files stay on disk for local reference; they are not tracked.
# IP-root README.md files remain tracked.
smc/peripherals/*/doc/*.md
smc/peripherals/*/doc/**/*.md
smc/smc_fabric/doc/*
!smc/smc_fabric/doc/*.adoc
smc/cpu_cluster/doc/*
!smc/cpu_cluster/doc/*.adoc
aou/doc/*
!aou/doc/*.adoc
sep/peripherals/*/doc/*.md

# ======================================================================================

# =============================================================================
# SMC VP firmware test build artifacts: see sw/smc-vp-tests/.gitignore.
# (Each test's Makefile builds TARGET=smc_<name>_test, UNDERSCORED so it never
# collides with its own hyphenated smc-<name>-test/ source directory -- a
# sw/smc-vp-tests/smc-*-test/smc-*-test pattern here would never match that
# binary name, so the ignore rule lives with the tests instead of here.)
# =============================================================================

# =============================================================================
# SPI flash fixtures and the VP config derived from accellera_config.ini with
# spiPreload disabled. sep-vp chdir's to the config directory, so the fixture has
# to be staged there rather than beside the test. `make clean` removes both.
# =============================================================================
vp/platform/sep/config/accellera_config_no_spipreload.ini
# Derived the same way, plus a spiBackdoorFile line naming the test's own fixture, by
# sep-spi-dma-test and sep-spi-mux-test.
vp/platform/sep/config/accellera_config_spi_*_test.ini
# Derived the same way, for the sep_efuse_fw_* tests that run on an erased fuse array.
vp/platform/sep/config/accellera_config_efuse_blank.ini
vp/platform/sep/config/efuse_vp_blank.ini
vp/platform/sep/config/data/
sw/sep-vp-tests/sep-spi-*-test/flash_fixture.bin
sw/sep-vp-tests/sep-spi-*-test/.staged-mode

# Local slide decks — keep on disk, do not publish
doc/AI_Agent_Usage.pptx
doc/ai-systemc-generation.pptx

# Top-level doc/ is local-only except the customer-facing VP guide.
# Other files stay on disk; they are not tracked.
/doc/*
!/doc/SystemC_Virtual_Platform_Customer_Guide.md

# Root docs/ (OCH GitHub Pages) and scripts/ (PDF helpers) are local-only.
/docs/
/scripts/

# Documentation PDFs are local-only (rebuild locally with scripts/build_docs.sh).
# Repeated after directory un-ignore rules (!smc/cpu_cluster/doc/** etc.)
# so those exceptions cannot re-track PDFs.
*.pdf

# Legacy SEP hardware-spec dumps (docs/, plural). Canonical pages are
# AsciiDoc under doc/. Files stay on disk for local reference.
sep/peripherals/*/docs/

# =============================================================================
# End of .gitignore
# =============================================================================

