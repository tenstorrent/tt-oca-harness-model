              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Indicates number of instructions the PKA has executed since the last CTRL.GO was issued.
This register is automatically cleared at the next assertion of CTRL.GO and retains its value after the execution has stopped.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
