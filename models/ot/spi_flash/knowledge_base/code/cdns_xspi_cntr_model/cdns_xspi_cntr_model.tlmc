                  <name>xspi_ctrl_fix</name>
                  <startBit>8</startBit>
                  <endBit>15</endBit>
                  <resetValue>0x2</resetValue>
                  <documentation>Fixed number (minor revision number).</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>xspi_ctrl_magic_number</name>
                  <startBit>16</startBit>
                  <endBit>31</endBit>
                  <resetValue>0x6522</resetValue>
                  <documentation>Controller&apos;s &apos;Magic Number&apos;.
It is a unique number characteristic to the
Cadence&apos;s xSPI Controller.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>ctrl_features_reg</name>
              <origin>0x4</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Shows available hardware features of the controller</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
