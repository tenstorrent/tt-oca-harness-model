          </bitfields>
        </register>
        <register>
          <name>phy_features_reg</name>
          <origin>0x74</origin>
          <quantity></quantity>
          <spacing></spacing>
          <resetValue></resetValue>
          <resetMask></resetMask>
          <documentation>This register shows available hardware features.</documentation>
          <readBehavior>None</readBehavior>
          <writeBehavior>None</writeBehavior>
          <restriction>ReadOnlyIgnore</restriction>
          <dataType>unsigned int</dataType>
          <bitfields>
            <bitfield>
              <name>onfi_40</name>
              <startBit>0</startBit>
              <endBit>0</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for ONFI4.0 - NAND Flash.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>onfi_41</name>
              <startBit>1</startBit>
              <endBit>1</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for ONFI4.1 - NAND Flash.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>sdr_16bit</name>
              <startBit>2</startBit>
              <endBit>2</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for 16bit in ONFI SDR work mode.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>xspi</name>
              <startBit>3</startBit>
              <endBit>3</endBit>
              <resetValue>0x1</resetValue>
              <documentation>Support for XSPI.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>sd_emmc</name>
              <startBit>4</startBit>
              <endBit>4</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for SD/eMMC.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>bank_num</name>
              <startBit>5</startBit>
              <endBit>6</endBit>
              <resetValue>0x3</resetValue>
              <documentation>Maximum number of banks supported by hardware. This is an encoded value. [list][*]0 - One bank. [*]1 - Two banks. [*]2 - Four banks. [*]3 - Eight banks.[/list]</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>dll_tap_num</name>
              <startBit>7</startBit>
              <endBit>7</endBit>
              <resetValue>0x1</resetValue>
              <documentation>Number of taps in delay line. This is an encoded value. [list][*]0 - 128. [*]1 - 256. [/list]</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>aging</name>
              <startBit>8</startBit>
              <endBit>8</endBit>
              <resetValue>0x1</resetValue>
              <documentation>Support for aging in delay lines.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>dfi_clock_ratio</name>
              <startBit>9</startBit>
              <endBit>9</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for clock ratio on DFI interface. This is an encoded value. [list][*]0 - 1:1 [*]1 - 1:2 [/list]</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>per_bit_deskew</name>
              <startBit>10</startBit>
              <endBit>10</endBit>
              <resetValue>0x0</resetValue>
              <documentation>Support for per-bit deskew.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>reg_intf</name>
              <startBit>11</startBit>
              <endBit>11</endBit>
              <resetValue>0x1</resetValue>
              <documentation>SFR interface type.  This is an encoded value. [list][*]0 - DFI. [*]1 - APB.[/list]</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
