            <register>
              <name>prog_seq_cfg_2</name>
              <origin>0x28</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Register to configure PROGRAM sequence for PROFILE 2 in
ACMD and DIRECT work modes.</documentation>
