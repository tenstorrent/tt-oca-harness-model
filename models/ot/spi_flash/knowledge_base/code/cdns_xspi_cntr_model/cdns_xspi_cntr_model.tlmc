                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>cmd_reg3</name>
              <origin>0xc</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Command register 3. This register is only used in CDMA/PIO(IP6522 only) and STIG work mode, and the definition changes depending on the workmode. Refer to the applicable section in the UserGuide.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>cmd3</name>
                  <startBit>0</startBit>
                  <endBit>31</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Command 3 register field.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>cmd_reg4</name>
              <origin>0x10</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Command register 4. This register is only used in CDMA/PIO(IP6522 only) and STIG work mode, and the definition changes depending on the workmode. Refer to the applicable section in the UserGuide.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>cmd4</name>
                  <startBit>0</startBit>
                  <endBit>31</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Command 4 register field.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>cmd_reg5</name>
              <origin>0x14</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Command register 5. This register is only used in CDMA/PIO(IP6522 only) and STIG work mode, and the definition changes depending on the workmode. Refer to the applicable section in the UserGuide.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>cmd5</name>
                  <startBit>0</startBit>
                  <endBit>31</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Command 5 register field.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>cmd_status_ptr</name>
              <origin>0x40</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>This register is relevant for ACMD mode only and selects which thread will be used for outputting the command status in the cmd_status register.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>thrd_status_sel</name>
                  <startBit>0</startBit>
                  <endBit>2</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Thread ID whose status will be available in the cmd_status register.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>cmd_status</name>
              <origin>0x44</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>This status register reports the Command Status
for the selected thread in ACMD work mode and
for STIG work mode when an xSPI flash transaction has completed.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>cmd_status</name>
                  <startBit>0</startBit>
                  <endBit>31</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Command status register field. When operating in ACMD mode, this field reports the descriptor status associated with the selected thread (the thread to which this status belongs is selected via the cmd_status_ptr register). 
Refer to the UserGuide, section &apos;Status Checking&apos; within the section &apos;Operating in Auto Command (ACMD) work mode&apos; for a full bitwise definition.
When operating in STIG mode mode, this register reports the STIG completion status. Refer to the UserGuide, section &apos;Checking STIG Completion Status&apos; for a full bitwise definition.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>ctrl_status</name>
              <origin>0x100</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>General Controller Status Register.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>sdma_busy</name>
                  <startBit>0</startBit>
                  <endBit>0</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>When set, the AXI Slave interface is busy.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>mdma_busy</name>
                  <startBit>1</startBit>
                  <endBit>1</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>When set, the AXI Master interface is busy..</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>acmd_eng_busy</name>
                  <startBit>2</startBit>
                  <endBit>2</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>When set, the Auto Command Engine is busy (ACMD mode only).</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gcmd_eng_busy</name>
                  <startBit>3</startBit>
                  <endBit>3</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>When operating in DIRECT work mode, this bit will be set high when the DIRECT CMD Generator is busy. Note that no new request on the AXI slave interface will be accepted while this is high When operating in STIG work mode, this bit will be set while the STIG engine is busy.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gcmd_eng_mc_busy</name>
                  <startBit>4</startBit>
                  <endBit>4</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is relevant for STIG mode only. This bit indicates when the controller is waiting for next/last instruction in glued instruction chain or it is executing requested sequence on the xSPI i/f.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>discovery_busy</name>
                  <startBit>6</startBit>
                  <endBit>6</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>When set, Device Discovery is in progress. When Device Discovery is inhibited then this bit is also set during the PHY initialization procedure.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>ctrl_busy</name>
                  <startBit>7</startBit>
                  <endBit>7</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit indicates if controller is in the busy state or not.
1: Controller is busy.
0: Controller is idle.
Note that this bit is also routed to the controller interface via the ctrl_busy pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>init_fail</name>
                  <startBit>8</startBit>
                  <endBit>9</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Initialization process status:
2&apos;b00: xSPI device detected,
2&apos;b01: Initialization has failed,
2&apos;b10: Legacy SPI device detected,
2&apos;b11: n/a.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>init_comp</name>
                  <startBit>16</startBit>
                  <endBit>16</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when the Cadence xSPI Controller has completed its reset and initialization process.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>trd_status</name>
              <origin>0x104</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Auto Command Engine Thread Status (ACMD mode only).</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>trd_busy</name>
                  <startBit>0</startBit>
                  <endBit>7</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit indicates the Auto Command Engine thread busy status. When set, the corresponding thread is currently busy.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>intr_status</name>
              <origin>0x110</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Interrupt status register.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>gp_open_drain_0</name>
                  <startBit>12</startBit>
                  <endBit>12</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This simply reflects that a HIGH-to-LOW or LOW-to-HIGH transition detected on the xspi_dfi_gp_open_drain[0] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_1</name>
                  <startBit>13</startBit>
                  <endBit>13</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This simply reflects that a HIGH-to-LOW or LOW-to-HIGH transition detected on the xspi_dfi_gp_open_drain[1] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_2</name>
                  <startBit>14</startBit>
                  <endBit>14</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This simply reflects that a HIGH-to-LOW or LOW-to-HIGH transition detected on the xspi_dfi_gp_open_drain[2] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_3</name>
                  <startBit>15</startBit>
                  <endBit>15</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This simply reflects that a HIGH-to-LOW or LOW-to-HIGH transition was detected on the xspi_dfi_gp_open_drain[3] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>ctrl_idle</name>
                  <startBit>16</startBit>
                  <endBit>16</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This is general status and indicates that the xSPI controller has returned to an IDLE state.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>cdma_terr</name>
                  <startBit>17</startBit>
                  <endBit>17</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Command DMA Target error. ACMD mode only. This bit will be set if a system bus error was detected on the AXI Master Interface during descriptor reads or writes</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>ddma_terr</name>
                  <startBit>18</startBit>
                  <endBit>18</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Master Data DMA Target error. ACMD mode only. This bit will be set if a system bus error was detected on the AXI Master Interface during data reads or writes</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>cmd_ignored</name>
                  <startBit>20</startBit>
                  <endBit>20</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>ACMD work mode: The controller detected that a command that was sent by the host was to an already busy thread and ignored it.
STIG work mode: The controller detected that a command was sent when the STIG engine was already busy and ignored it.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>sdma_trigg</name>
                  <startBit>21</startBit>
                  <endBit>21</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when the trigger condition for the Slave DMA is met. It is relevant to STIG and ACMD mode only and used to instruct the host when an access on the AXI slave interface is to be performed. This is explained in more detail in the Operating in ACMD or STIG mode sections of the UserGuide</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>sdma_err</name>
                  <startBit>22</startBit>
                  <endBit>22</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when an illegal access to the Slave DMA interface is detected.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>stig_done</name>
                  <startBit>23</startBit>
                  <endBit>23</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when the last instruction in glued chain has completed.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dir_crc_err</name>
                  <startBit>24</startBit>
                  <endBit>24</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when CRC checking is enabled and a CRC error after a read or status checking command in DIRECT work mode has been detected.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dir_dqs_err</name>
                  <startBit>25</startBit>
                  <endBit>25</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is set when an incorrect number of DQS pulses were detected during a DIRECT mode read or status check. Essentially this status is passed from the soft PHY and could mean that the PHY is configured badly such that it expects DQS strobes but never received them or that the rd_del_sel value is incorrect and has caused data corruption and pointer misalignment in the PHY.  To resolve this issue the PHY must be reset to clear the dqs_underrun and dqs_overflow flags and reset the read data pointers.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dir_cmd_err</name>
                  <startBit>26</startBit>
                  <endBit>26</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>This bit is typically set when the host has attempted to do something that is unsupported or incorrect. An example could be that the host has triggered a write when the device is operating in XIP mode. The full list of error conditions is described in the Error/Event Handling section of the UserGuide.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dir_ecc_corr_err</name>
                  <startBit>27</startBit>
                  <endBit>27</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>For IP6522A, this bit is set when a correctable ECC error occurs in DIRECT mode.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dir_dev_err</name>
                  <startBit>28</startBit>
                  <endBit>28</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Set when a program operation in DIRECT mode failed. That is, the device returned the program fail bit when the status was checked. For IP6522A, this bit is also set when uncorrectable ECC error occurs in DIRECT mode.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>ClearOnWrite1</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
              </bitfields>
            </register>
            <register>
              <name>intr_enable</name>
              <origin>0x114</origin>
              <quantity></quantity>
              <spacing></spacing>
              <resetValue></resetValue>
              <resetMask></resetMask>
              <documentation>Interrupt enable register. If the selected bit of this register is set, the rising edge of the corresponding bit in intr_status will trigger an interrupt.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>None</restriction>
              <dataType>unsigned int</dataType>
              <bitfields>
                <bitfield>
                  <name>gp_open_drain_0_en</name>
                  <startBit>12</startBit>
                  <endBit>12</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting the HIGH-to-LOW or LOW-to-HIGH transition on the xspi_dfi_gp_open_drain[0] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_1_en</name>
                  <startBit>13</startBit>
                  <endBit>13</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting the HIGH-to-LOW or LOW-to-HIGH transition on the xspi_dfi_gp_open_drain[1] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_2_en</name>
                  <startBit>14</startBit>
                  <endBit>14</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting the HIGH-to-LOW or LOW-to-HIGH transition on the xspi_dfi_gp_open_drain[2] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>gp_open_drain_3_en</name>
                  <startBit>15</startBit>
                  <endBit>15</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting the HIGH-to-LOW or LOW-to-HIGH transition on the xspi_dfi_gp_open_drain[3] input pin.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>ctrl_idle_en</name>
                  <startBit>16</startBit>
                  <endBit>16</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting that Controller has returned to the IDLE state.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>cdma_terr_en</name>
                  <startBit>17</startBit>
                  <endBit>17</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting Auto CMD Engine target error.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>ddma_terr_en</name>
                  <startBit>18</startBit>
                  <endBit>18</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting Data DMA Master target error.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>cmd_ignored_en</name>
                  <startBit>20</startBit>
                  <endBit>20</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Interrupt enable for detecting of ignored command.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>sdma_trigg_en</name>
                  <startBit>21</startBit>
                  <endBit>21</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Enables interrupt when the trigger condition for the Slave DMA is met.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>sdma_err_en</name>
                  <startBit>22</startBit>
                  <endBit>22</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>Enables interrupt when an illegal access to the Slave DMA interface is detected.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>None</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
