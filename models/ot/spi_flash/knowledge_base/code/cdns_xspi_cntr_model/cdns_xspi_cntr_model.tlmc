              <documentation>PHY revision number.</documentation>
              <readBehavior>None</readBehavior>
              <writeBehavior>None</writeBehavior>
              <restriction>ReadOnlyIgnore</restriction>
              <enums/>
              <bitfields/>
            </bitfield>
            <bitfield>
              <name>phy_fix</name>
              <startBit>8</startBit>
