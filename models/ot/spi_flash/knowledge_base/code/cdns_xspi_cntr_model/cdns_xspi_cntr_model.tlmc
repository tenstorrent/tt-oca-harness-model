              <bitfields>
                <bitfield>
                  <name>n_threads</name>
                  <startBit>0</startBit>
                  <endBit>3</endBit>
                  <resetValue>0x3</resetValue>
                  <documentation>Number of threads available in the controller. The following decoding is used:[list]
[*]0 - One thread
[*]1 - Two threads
[*]2 - Four threads
[*]3 - Eight threads
[*]4-15 - Reserved[/list]</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>asf_available</name>
                  <startBit>12</startBit>
                  <endBit>12</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>ASF features present.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>boot_available</name>
                  <startBit>16</startBit>
                  <endBit>16</endBit>
                  <resetValue>0x1</resetValue>
                  <documentation>Boot feature present.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dma_intf</name>
                  <startBit>18</startBit>
                  <endBit>19</endBit>
                  <resetValue>0x0</resetValue>
                  <documentation>DMA interface type (0-AXI4 other values reserved).</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dma_addr_width</name>
                  <startBit>20</startBit>
                  <endBit>20</endBit>
                  <resetValue>0x1</resetValue>
                  <documentation>Slave
and Master
DMA address width:
[list]
[*]0 - 32bit,
[*]1 - 64bit.
[/list]</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>dma_data_width</name>
                  <startBit>21</startBit>
                  <endBit>21</endBit>
                  <resetValue>0x1</resetValue>
                  <documentation>Slave
and Master
DMA data width:
[list]
[*]0 - 32bit,
[*]1 - 64bit.
[/list]</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>sfr_intf</name>
                  <startBit>22</startBit>
                  <endBit>23</endBit>
                  <resetValue>0x1</resetValue>
                  <documentation>SFR interface type  1-APB, other values reserved.</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
                  <enums/>
                  <bitfields/>
                </bitfield>
                <bitfield>
                  <name>n_banks</name>
                  <startBit>24</startBit>
                  <endBit>25</endBit>
                  <resetValue>0x3</resetValue>
                  <documentation>Maximum number of banks supported by hardware. This is an encoded value.[list]
[*]0 - One bank,
[*]1 - Two banks,
[*]2 - Four banks,
[*]3 - Eight banks.[/list]</documentation>
                  <readBehavior>None</readBehavior>
                  <writeBehavior>None</writeBehavior>
                  <restriction>ReadOnlyIgnore</restriction>
