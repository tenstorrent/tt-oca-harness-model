# Local dependency paths for run_tests.sh.
#
# First-time setup:
#   cp deps.env.example deps.env
#   # edit the exports below to match your install prefixes
#   ./run_tests.sh
#
# deps.env is gitignored -- each developer keeps their own copy.
#
# IMPORTANT: CCI must be linked against the *same* SystemC build. On this
# tree the VP-compatible pair is typically:
#   SYSTEMC_HOME=/usr/local/systemc-3.0.2
#   CCI_HOME=/usr/local/cci-1.0.1
# Homebrew SystemC (/opt/homebrew/opt/systemc) will mis-match CCI and fail
# at cci_param construction with an originator error.

# Accellera SystemC (must contain include/systemc.h)
export SYSTEMC_HOME=/path/to/systemc

# Accellera SystemC CCI 1.0 (must contain include/cci_configuration)
export CCI_HOME=/path/to/cci
