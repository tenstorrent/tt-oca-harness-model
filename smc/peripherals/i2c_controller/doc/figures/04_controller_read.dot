// Controller-Mode READ flow.  Render:  dot -Tsvg 04_controller_read.dot -o 04_controller_read.svg
digraph cread {
  rankdir=TB;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  n1 [label="FDATA { (addr<<1)|1 , START }"];
  n2 [label="FDATA { N , READB , STOP }\n(N = 0 means 256 bytes)"];
  n3 [label="drain_fmt segment: dir = READ, read_len = N"];
  n4 [label="bus_model returns ack + read_data[...]"];
  n5 [label="push each byte to RX FIFO\n(set RX_OVERFLOW if full)"];
  n6 [label="FW reads RDATA until STATUS.RXEMPTY", fillcolor="#d7f5d7"];

  n1 -> n2 -> n3 -> n4 -> n5 -> n6;
}
