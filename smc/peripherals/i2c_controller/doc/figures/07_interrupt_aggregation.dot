// Interrupt aggregation.  Render:  dot -Tsvg 07_interrupt_aggregation.dot -o 07_interrupt_aggregation.svg
digraph intr {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  L   [label="level_status()\nFMT/RX/ACQ/TX thresholds,\nCONTROLLER_HALT, TX_STRETCH"];
  LA  [label="intr_latched_ (W1C events:\nCMD_COMPLETE, RX_OVERFLOW,\nFIFO errors, ...)"];
  FO  [label="intr_force_\n(INTR_TEST)"];
  OR  [label="OR", shape=circle, fillcolor="#e6e6e6"];
  IS  [label="INTR_STATE"];
  AND [label="AND", shape=circle, fillcolor="#e6e6e6"];
  IE  [label="INTR_ENABLE"];
  ACT [label="irq_active"];
  RC  [label="recompute_method\n(sole writer of irq_o)"];
  IRQ [label="irq_o", fillcolor="#ffe9c7"];

  L  -> OR;
  LA -> OR;
  FO -> OR;
  OR -> IS -> AND;
  IE -> AND;
  AND -> ACT -> RC -> IRQ;
}
