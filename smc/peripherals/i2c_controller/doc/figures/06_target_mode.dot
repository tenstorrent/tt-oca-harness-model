// Target-Mode flow (external controller drives this device).  Render:  dot -Tsvg 06_target_mode.dot -o 06_target_mode.svg
digraph target {
  rankdir=TB;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  n0   [label="CTRL.ENABLETARGET = 1;\nprogram TARGET_ID (addr0/mask0, addr1/mask1)"];
  w    [label="target_write(addr, data, stop)"];
  m    [label="addr matches a TARGET_ID slot?\n(addr & mask) == (id & mask)", shape=diamond, fillcolor="#fff7cc"];
  acq  [label="ACQ: Start((addr<<1)|0) . Data(b)* . Stop\nlatch START_DET / STOP_DET", fillcolor="#d7f5d7"];
  nack [label="NACK; TARGET_NACK_COUNT++", fillcolor="#f8d7da"];
  r    [label="target_read(addr, nbytes, out, stop)"];
  tx   [label="pop up to nbytes from TX FIFO\n(previously filled via TXDATA)"];

  n0 -> w;
  w  -> m;
  m  -> acq  [label="yes"];
  m  -> nack [label="no"];
  n0 -> r [style=dashed, label="read path"];
  r  -> tx;
}
