// Structural architecture of smc::i2c_controller.  Render:  dot -Tsvg 01_architecture.dot -o 01_architecture.svg
digraph arch {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  subgraph cluster_init {
    label="Initiator (CPU / fabric / test bench)"; style=filled; color="#cccccc"; fillcolor="#f7f7f7";
    QK    [label="tlm_quantumkeeper\n(temporal decoupling)"];
    ISOCK [label="simple_initiator_socket"];
    QK -> ISOCK [dir=none];
  }

  subgraph cluster_dut {
    label="SC_MODULE smc::i2c_controller"; style=filled; color="#9fb8dd"; fillcolor="#ffffff";
    RSOCK  [label="reg_socket\n(simple_target_socket)"];
    DECODE [label="b_transport / transport_dbg\nreg_read() / reg_write()"];

    subgraph cluster_regs {
      label="Register storage"; style=filled; color="#bbbbbb"; fillcolor="#fbfbee";
      MAP [label="regmap_ (RegisterMap32)\nplain masked regs"];
      BEH [label="behavioural regs\nINTR_*, CTRL, EVENTS,\nNACK_COUNT, ACK_CTRL"];
    }
    subgraph cluster_fifos {
      label="FIFOs (std::deque)"; style=filled; color="#bbbbbb"; fillcolor="#eefbf0";
      FMT [label="FMT (ctrl TX)"];
      RX  [label="RX (ctrl RX)"];
      TXF [label="TX (target TX)"];
      ACQ [label="ACQ (target RX)"];
    }
    ENG [label="drain_fmt()\nsegment engine"];
    BUS [label="bus_model_fn\n(remote target emulator)"];
    subgraph cluster_proc {
      label="SC_METHOD processes"; style=filled; color="#bbbbbb"; fillcolor="#fbeef3";
      RST  [label="reset_proc  <- rst_n_i"];
      XFER [label="xfer_method  <- xfer_event_"];
      RECO [label="recompute_method  <- recompute_event_"];
    }
  }
  IRQ  [label="irq_o", fillcolor="#ffe9c7"];
  RSTN [label="rst_n_i", fillcolor="#ffe9c7"];

  ISOCK  -> RSOCK  [label="b_transport(gp, delay)"];
  RSOCK  -> DECODE;
  DECODE -> MAP;
  DECODE -> BEH;
  DECODE -> FMT [label="FDATA push"];
  RX     -> DECODE [label="RDATA pop"];
  DECODE -> TXF [label="TXDATA push"];
  ACQ    -> DECODE [label="ACQDATA pop"];
  FMT    -> ENG;
  ENG    -> BUS [dir=both, label="i2c_xfer"];
  ENG    -> RX  [label="read data"];
  XFER   -> ENG;
  BEH    -> RECO;
  RECO   -> IRQ [label="single driver"];
  RSTN   -> RST;
}
