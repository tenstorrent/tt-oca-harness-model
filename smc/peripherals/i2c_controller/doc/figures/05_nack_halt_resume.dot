// NACK / halt / resume flow.  Render:  dot -Tsvg 05_nack_halt_resume.dot -o 05_nack_halt_resume.svg
digraph nack {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  A   [label="execute FMT segment"];
  B   [label="target ack?", shape=diamond, fillcolor="#fff7cc"];
  OK  [label="complete segment\n(READ->RX, STOP->CMD_COMPLETE)", fillcolor="#d7f5d7"];
  OK2 [label="ignore NACK, keep going", fillcolor="#d7f5d7"];
  H   [label="CONTROLLER_EVENTS.NACK = 1\nhalted_ = true\nCONTROLLER_HALT (level)", fillcolor="#f8d7da"];
  W   [label="FW writes CONTROLLER_EVENTS (W1C)"];
  R   [label="halted_ = false;\nreschedule xfer -> drain remaining FMT"];

  A -> B;
  B -> OK  [label="ack"];
  B -> OK2 [label="NACK & FDATA.NAKOK"];
  B -> H   [label="NACK & !NAKOK"];
  H -> W -> R;
}
