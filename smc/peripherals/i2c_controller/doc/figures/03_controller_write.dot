// Controller-Mode WRITE flow.  Render:  dot -Tsvg 03_controller_write.dot -o 03_controller_write.svg
digraph cwrite {
  rankdir=TB;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#eef3fb", fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  n1 [label="CTRL.ENABLEHOST = 1"];
  n2 [label="FDATA { (addr<<1)|0 , START }\nFDATA { data }\nFDATA { data , STOP }"];
  n3 [label="push_fmt() -> FMT FIFO"];
  n4 [label="schedule_xfer(+xfer_delay_ns)"];
  n5 [label="xfer_method -> drain_fmt():\nreassemble START..STOP into one segment"];
  n6 [label="bus_model( i2c_xfer{addr, WRITE, bytes} )"];
  n7 [label="ack; STOP latches CMD_COMPLETE"];
  n8 [label="recompute_method drives irq_o\n(if CMD_COMPLETE enabled)", fillcolor="#ffe9c7"];

  n1 -> n2 -> n3 -> n4 -> n5 -> n6 -> n7 -> n8;
}
