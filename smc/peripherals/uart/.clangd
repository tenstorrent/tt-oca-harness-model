CompileFlags:
  # The UART IP is built standalone (run_tests.sh -> build/), and is not yet
  # part of the smc_fabric build that the repo-root .clangd points at.  Point
  # clangd at this IP's own compile_commands.json so go-to-definition,
  # find-references, and hover resolve uart.h/uart.cpp, SystemC, and CCI
  # symbols here.  The closest .clangd wins, so this overrides the root config
  # for files under peripherals/uart/.
  CompilationDatabase: /localdev/rmalhotra/tt-oca-sim/smc/peripherals/uart/build
