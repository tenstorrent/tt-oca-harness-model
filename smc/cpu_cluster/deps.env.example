# Local dependency paths for run_tests.sh.
#
# First-time setup (see README.md § "First-time setup"):
#   cp deps.env.example deps.env
#   # edit the four exports below to match your install prefixes
#   ./run_tests.sh
#
# deps.env is gitignored — each developer keeps their own copy.

# Step 1 — Accellera SystemC built with C++20 (must contain include/systemc.h)
export SYSTEMC_HOME=$HOME/local/systemc-2.3.4

# Step 2 — Boost >= 1.74 (must contain include/boost/version.hpp)
export BOOST_DIR=$HOME/local/boost-1.84.0

# Step 3 — Whisper source checkout (directory containing GNUmakefile)
export WHISPER_HOME=$HOME/whisper/whisper

# Step 4 — Accellera SystemC CCI 1.0 (must contain include/cci_configuration)
export CCI_HOME=$HOME/local/cci-install
