`ifndef MAILBOX_WRAP_RDL_DEFINED
`define MAILBOX_WRAP_RDL_DEFINED

`include "mailbox.rdl"

// SEP instantiates eight mailbox channels (sep_pkg::NUM_MAILBOXES). Mirrors
// hw/ip/axi_lite_mailbox_unit/regs/axil_mailbox_sep_wrap.rdl. The SMC wrapper
// is the same structure with 32 channels.
addrmap mailbox_wrap {
    desc = "";

    mailbox     outbound_mailbox_0      @0x000_0000;
    mailbox     inbound_mailbox_0       @0x000_0800;
    mailbox     outbound_mailbox_1      @0x000_1000;
    mailbox     inbound_mailbox_1       @0x000_1800;
    mailbox     outbound_mailbox_2      @0x000_2000;
    mailbox     inbound_mailbox_2       @0x000_2800;
    mailbox     outbound_mailbox_3      @0x000_3000;
    mailbox     inbound_mailbox_3       @0x000_3800;
    mailbox     outbound_mailbox_4      @0x000_4000;
    mailbox     inbound_mailbox_4       @0x000_4800;
    mailbox     outbound_mailbox_5      @0x000_5000;
    mailbox     inbound_mailbox_5       @0x000_5800;
    mailbox     outbound_mailbox_6      @0x000_6000;
    mailbox     inbound_mailbox_6       @0x000_6800;
    mailbox     outbound_mailbox_7      @0x000_7000;
    mailbox     inbound_mailbox_7       @0x000_7800;

};

`endif
