# Local dependency paths for run_all_peripherals.sh and vp/configure_vp.sh.
#
# First-time setup:
#   cp deps.env.example deps.env
#   # edit the exports below to match your install prefixes
#   source deps.env
#   ./run_all_peripherals.sh
#
# deps.env is gitignored -- each developer keeps their own copy.
#
# macOS notes (Apple Silicon / Homebrew):
#   - SYSTEMC_HOME / CCI_HOME must point at installs built for the SAME C++
#     standard (CMAKE_CXX_STANDARD below) -- SystemC's ABI is keyed per
#     language standard, so a mismatch fails to link with an undefined
#     sc_api_version_* symbol.
#   - Homebrew Boost/OpenSSL are auto-discovered by vp/configure_vp.sh if
#     BOOST_ROOT/OPENSSL_ROOT are left unset; set them explicitly here to
#     skip probing or to point at non-Homebrew installs.

# Accellera SystemC (must contain include/systemc.h)
export SYSTEMC_HOME=$HOME/local/systemc-3.0.2

# Accellera SystemC CCI 1.0 (must contain include/cci_configuration)
export CCI_HOME=$HOME/local/cci-1.0.1

# OpenSSL >= 3.0 (kmac requires EVP_MAC / openssl/core_names.h)
export OPENSSL_ROOT=/opt/homebrew/opt/openssl@3

# Boost >= 1.74 (must contain include/boost/version.hpp)
export BOOST_ROOT=/opt/homebrew/opt/boost

export CMAKE_CXX_STANDARD=17
export CMAKE_BUILD_TYPE=Debug

export DYLD_LIBRARY_PATH="${SYSTEMC_HOME}/lib:${CCI_HOME}/lib:${OPENSSL_ROOT}/lib:${BOOST_ROOT}/lib:${DYLD_LIBRARY_PATH:-}"

# RISC-V toolchain for sw/sep-vp-tests (make RISCV_PREFIX=$RISCV_PREFIX)
export RISCV_PREFIX=riscv64-elf-
export PATH="/opt/homebrew/opt/riscv64-elf-gcc/bin:/opt/homebrew/opt/riscv64-elf-binutils/bin:${PATH}"
