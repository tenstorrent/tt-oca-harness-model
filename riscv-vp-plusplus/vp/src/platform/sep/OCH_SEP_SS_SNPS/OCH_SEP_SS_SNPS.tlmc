    </parameter>
    <parameter>
      <name>HART0_VERBOSE</name>
      <type>Bool</type>
      <defaultValue>true</defaultValue>
      <documentation>When true, enable verbose logging.</documentation>
      <allowedValues/>
    </parameter>
    <parameter>
      <name>HART0_TRACELDST</name>
      <type>Bool</type>
      <defaultValue>true</defaultValue>
      <documentation>Trace ld/st data address if true.</documentation>
      <allowedValues/>
    </parameter>
    <parameter>
      <name>HART0_CSV</name>
      <type>Bool</type>
      <defaultValue>false</defaultValue>
      <documentation>Log files in CSV format when true.</documentation>
      <allowedValues/>
    </parameter>
    <parameter>
      <name>HART0_TRIGGERS</name>
      <type>Bool</type>
      <defaultValue>true</defaultValue>
      <documentation>Enable debug triggers when true.</documentation>
      <allowedValues/>
    </parameter>
    <parameter>
      <name>HART0_COUNTERS</name>
      <type>Bool</type>
      <defaultValue>true</defaultValue>
