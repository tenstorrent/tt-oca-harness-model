# Toolchain
# Set RISCV_PREFIX in the environment or on the command line to pin one.
# Otherwise probe the prefixes the supported hosts ship, so a bare `make` works
# everywhere: Ubuntu/RHEL install riscv64-unknown-elf-, macOS Homebrew installs
# riscv64-elf-, and the xpack builds use riscv-none-elf-.  RISCV_TOOLCHAIN_PATH
# points at a toolchain that is not on PATH (RHEL module trees, bundled zips).
# Candidate order matches sw/sep-vp-tests/run_sep_vp_tests.sh.
RISCV_PREFIX_CANDIDATES ?= riscv64-unknown-elf- riscv64-elf- riscv-none-elf- \
                           riscv64-linux-gnu- riscv-none-embed-

ifneq ($(strip $(RISCV_TOOLCHAIN_PATH)),)
RISCV_BINDIR := $(RISCV_TOOLCHAIN_PATH)/bin/
endif

ifeq ($(origin RISCV_PREFIX), undefined)
RISCV_PREFIX := $(firstword $(foreach p,$(RISCV_PREFIX_CANDIDATES), \
                  $(if $(shell command -v $(RISCV_BINDIR)$(p)gcc 2>/dev/null),$(RISCV_BINDIR)$(p))))
endif

ifeq ($(strip $(RISCV_PREFIX)),)
ifeq ($(filter clean,$(MAKECMDGOALS)),)
$(error No RISC-V toolchain found. Set RISCV_PREFIX or RISCV_TOOLCHAIN_PATH, or install one: \
macOS "brew install riscv64-elf-gcc"; Ubuntu "sudo apt install gcc-riscv64-unknown-elf"; \
RHEL/TT "module load riscv-gnu-toolchain/2025.01.20-rhel-8.10")
endif
endif

CC = $(RISCV_PREFIX)gcc
OBJCOPY = $(RISCV_PREFIX)objcopy
OBJDUMP = $(RISCV_PREFIX)objdump

# Architecture
# GCC 11+ splits CSR/privileged insns into zicsr; start.S uses csrw/mret.
ABI = ilp32
GCC_MAJOR := $(shell $(CC) -dumpversion 2>/dev/null | cut -f1 -d.)
ifeq ($(shell expr $(GCC_MAJOR) \>= 11 2>/dev/null),1)
ARCH = rv32imc_zicsr_zifencei
else
ARCH = rv32imc
endif

# Common include paths — single authoritative register header + shared helpers
SEP_VP_TESTS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
COMMON_INCS = -I$(SEP_VP_TESTS_DIR)common \
              -I$(SEP_VP_TESTS_DIR)fw-tests-from-tt-oca-hw/dependencies/meta/registers/c

# Compiler flags
CFLAGS = -march=$(ARCH) -mabi=$(ABI) -mno-relax
CFLAGS += -O0 -g
CFLAGS += -Wall -Wextra
CFLAGS += -ffreestanding -nostdlib -nostartfiles
CFLAGS += $(COMMON_INCS)
CFLAGS += $(EXTRA_CFLAGS)

# Linker flags
LDFLAGS += -march=$(ARCH) -mabi=$(ABI) -mno-relax
LDFLAGS += -nostdlib -nostartfiles
#LDFLAGS += -T link.ld
LDFLAGS += -Wl,--no-relax,--print-memory-usage

# VP settings
VP = ../../../vp/build/bin/sep-vp
BASE_INI = ../../../vp/platform/sep/config/accellera_config.ini
VP_FLAGS = $(BASE_INI)

# Tests that read their data oracle out of the SPI flash need spiPreload disabled: that
# setting loads the bootcode image straight into the flash model's backing store, over
# whatever the test staged (or over the erased state it expects). Such a test opts in with
# `VP_FLAGS := $(NO_SPIPRELOAD_INI)` and lists it as a `sim` prerequisite. Derived with sed
# rather than checked in, so it tracks edits to the shared config instead of drifting.
#
# This config names no flash image, so it guarantees erased flash. A test that wants a raw
# image derives its own config instead and adds `och_sep_ss1.spiBackdoorFile`, pointing at a
# test-specific filename -- see sep-spi-dma-test and sep-spi-mux-test. Keep the image out of
# this shared config: several tests use it, and only some of them stage anything.
NO_SPIPRELOAD_INI = $(dir $(BASE_INI))accellera_config_no_spipreload.ini
GDB_ENABLED_FROM_INI := $(shell sed -n 's/^[[:space:]]*och_sep_ss1\.gdb[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' $(VP_FLAGS) 2>/dev/null | head -n 1)
GDB_ENABLED ?= $(if $(strip $(GDB_ENABLED_FROM_INI)),$(GDB_ENABLED_FROM_INI),false)
DEBUG_PORT_FROM_INI := $(shell sed -n 's/^[[:space:]]*och_sep_ss1\.gdbTcpPort[[:space:]]*:[[:space:]]*\[\([0-9]\+\)\].*/\1/p' $(VP_FLAGS) 2>/dev/null | head -n 1)
DEBUG_PORT ?= $(if $(strip $(DEBUG_PORT_FROM_INI)),$(DEBUG_PORT_FROM_INI),5005)
GDB = gdb-multiarch

.PHONY: all clean sim dump debug gdb

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ -lgcc

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	$(CC) $(CFLAGS) -c -o $@ $<

dump: $(TARGET)
	$(OBJDUMP) -D $(TARGET) > $(TARGET).dump
	$(OBJDUMP) -t $(TARGET) > $(TARGET).sym

sim: $(TARGET)
	$(VP) $(VP_FLAGS) $(TARGET)

debug: $(TARGET)
	@if [ "$(GDB_ENABLED)" != "true" ]; then \
		echo "Error: GDB is not enabled in $(VP_FLAGS). Set 'och_sep_ss1.gdb : true' in the ini file to use GDB."; \
		exit 1; \
	fi
	@echo "Starting sep-vp in debug mode on port $(DEBUG_PORT)..."
	@echo "Connect with GDB using: make gdb"
	$(VP) $(VP_FLAGS) $(TARGET)

gdb: $(TARGET)
	@if [ "$(GDB_ENABLED)" != "true" ]; then \
		echo "Error: GDB is not enabled in $(VP_FLAGS). Set 'och_sep_ss1.gdb : true' in the ini file to use GDB."; \
		exit 1; \
	fi
	@echo "Connecting to sep-vp on port $(DEBUG_PORT)..."
	$(GDB) $(TARGET) \
		-ex "target remote localhost:$(DEBUG_PORT)" \
		-ex "set architecture riscv:rv32"

$(NO_SPIPRELOAD_INI): $(BASE_INI)
	sed 's|^och_sep_ss1\.spiPreload|#&|' $< > $@

clean:
	rm -f $(OBJS) $(TARGET) $(TARGET).dump $(TARGET).sym
