# Toolchain
RISCV_PREFIX ?= riscv64-unknown-elf-
CC = $(RISCV_PREFIX)gcc
OBJCOPY = $(RISCV_PREFIX)objcopy
OBJDUMP = $(RISCV_PREFIX)objdump

# Architecture
# GCC 11+ splits CSR/privileged insns into zicsr; start.S uses csrw/mret.
ABI = ilp32
GCC_MAJOR := $(shell $(CC) -dumpversion 2>/dev/null | cut -f1 -d.)
ifeq ($(shell expr $(GCC_MAJOR) \>= 11 2>/dev/null),1)
ARCH = rv32imc_zicsr_zifencei
else
ARCH = rv32imc
endif

# Common include paths — single authoritative register header + shared helpers
SEP_VP_TESTS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
COMMON_INCS = -I$(SEP_VP_TESTS_DIR)common \
              -I$(SEP_VP_TESTS_DIR)../tt-oca-hw-main/meta/registers/c

# Compiler flags
CFLAGS = -march=$(ARCH) -mabi=$(ABI) -mno-relax
CFLAGS += -O0 -g
CFLAGS += -Wall -Wextra
CFLAGS += -ffreestanding -nostdlib -nostartfiles
CFLAGS += $(COMMON_INCS)
CFLAGS += $(EXTRA_CFLAGS)

# Linker flags
LDFLAGS += -march=$(ARCH) -mabi=$(ABI) -mno-relax
LDFLAGS += -nostdlib -nostartfiles
#LDFLAGS += -T link.ld
LDFLAGS += -Wl,--no-relax,--print-memory-usage

# VP settings
VP = ../../../vp/build/bin/sep-vp
VP_FLAGS = ../../../vp/platform/sep/config/accellera_config.ini
GDB_ENABLED_FROM_INI := $(shell sed -n 's/^[[:space:]]*och_sep_ss1\.gdb[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' $(VP_FLAGS) 2>/dev/null | head -n 1)
GDB_ENABLED ?= $(if $(strip $(GDB_ENABLED_FROM_INI)),$(GDB_ENABLED_FROM_INI),false)
DEBUG_PORT_FROM_INI := $(shell sed -n 's/^[[:space:]]*och_sep_ss1\.gdbTcpPort[[:space:]]*:[[:space:]]*\[\([0-9]\+\)\].*/\1/p' $(VP_FLAGS) 2>/dev/null | head -n 1)
DEBUG_PORT ?= $(if $(strip $(DEBUG_PORT_FROM_INI)),$(DEBUG_PORT_FROM_INI),5005)
GDB = gdb-multiarch

.PHONY: all clean sim dump debug gdb

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ -lgcc

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	$(CC) $(CFLAGS) -c -o $@ $<

dump: $(TARGET)
	$(OBJDUMP) -D $(TARGET) > $(TARGET).dump
	$(OBJDUMP) -t $(TARGET) > $(TARGET).sym

sim: $(TARGET)
	$(VP) $(VP_FLAGS) $(TARGET)

debug: $(TARGET)
	@if [ "$(GDB_ENABLED)" != "true" ]; then \
		echo "Error: GDB is not enabled in $(VP_FLAGS). Set 'och_sep_ss1.gdb : true' in the ini file to use GDB."; \
		exit 1; \
	fi
	@echo "Starting sep-vp in debug mode on port $(DEBUG_PORT)..."
	@echo "Connect with GDB using: make gdb"
	$(VP) $(VP_FLAGS) $(TARGET)

gdb: $(TARGET)
	@if [ "$(GDB_ENABLED)" != "true" ]; then \
		echo "Error: GDB is not enabled in $(VP_FLAGS). Set 'och_sep_ss1.gdb : true' in the ini file to use GDB."; \
		exit 1; \
	fi
	@echo "Connecting to sep-vp on port $(DEBUG_PORT)..."
	$(GDB) $(TARGET) \
		-ex "target remote localhost:$(DEBUG_PORT)" \
		-ex "set architecture riscv:rv32"

clean:
	rm -f $(OBJS) $(TARGET) $(TARGET).dump $(TARGET).sym
