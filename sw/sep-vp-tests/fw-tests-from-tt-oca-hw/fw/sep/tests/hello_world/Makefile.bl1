# Build hello_world as a BL1 flat binary for SPI boot testing.
#
# Produces build_bl1/hello_world_bl1.bin — a raw binary that rom_handoff_bl1()
# copies to ICCM.  crt0_bl1.s then moves .data from ICCM to DCCM at runtime.
#
# Usage:
#   make -f Makefile.bl1           # requires RV_ROOT, OCH_ROOT, SNAPSHOT_DIR

GCC_PREFIX ?= riscv64-unknown-elf

# Detect GCC version for march selection
ifneq ($(shell which $(GCC_PREFIX)-gcc 2> /dev/null),)
  GCCVERSIONGT11 := $(shell expr `$(GCC_PREFIX)-gcc -dumpversion | cut -f1 -d.` \>= 11)
  ifeq "$(GCCVERSIONGT11)" "1"
    CC_ABI = -mabi=ilp32 -march=rv32imc_zicsr_zifencei_zba_zbb_zbc_zbs
  else
    CC_ABI = -mabi=ilp32 -march=rv32imc
  endif
endif

LD_ABI = -mabi=ilp32 -march=rv32imac

SNAPSHOT_DIR ?= $(RV_ROOT)/snapshots/sep
PICOLIBC_DIR ?= $(RV_ROOT)/third_party/picolibc/install

SEP_TESTS_DIR    = $(OCH_ROOT)/fw/sep/tests
COMMON_DIR       = $(SEP_TESTS_DIR)/common
SEP_TOP_REG_DIR  = $(OCH_ROOT)/meta/registers/c
UART_REG_DIR     = $(OCH_ROOT)/hw/comp/uart_16550/data/registers/c

BUILD_DIR := build_bl1
LINKER_SCRIPT := $(COMMON_DIR)/exec_as_bl1.ld

INCS = -I$(SNAPSHOT_DIR) \
       -isystem $(PICOLIBC_DIR)/picolibc/$(GCC_PREFIX)/include \
       -I$(COMMON_DIR) \
       -I$(SEP_TOP_REG_DIR) \
       -I$(UART_REG_DIR)

CFLAGS  = -Os -fdata-sections -ffunction-sections -fno-common -fstack-usage $(INCS) $(CC_ABI)
LDFLAGS = -Wl,--gc-sections -Wl,-Map=$(BUILD_DIR)/hello_world_bl1.map \
          -T$(LINKER_SCRIPT) \
          --specs=$(PICOLIBC_DIR)/picolibc.specs \
          -nostartfiles

C_SRCS   = hello_world.c $(COMMON_DIR)/init_stdout.c
ASM_SRCS = $(COMMON_DIR)/crt0_bl1.s

OBJS = $(BUILD_DIR)/hello_world.o \
       $(BUILD_DIR)/init_stdout.o \
       $(BUILD_DIR)/crt0_bl1.o

ELF := $(BUILD_DIR)/hello_world_bl1.elf
BIN := $(BUILD_DIR)/hello_world_bl1.bin

.PHONY: all clean picolibc

all: $(BIN)

picolibc:
	$(MAKE) -f $(RV_ROOT)/tools/picolibc.mk all

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/hello_world.o: hello_world.c picolibc $(SNAPSHOT_DIR)/defines.h | $(BUILD_DIR)
	$(GCC_PREFIX)-gcc $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/init_stdout.o: $(COMMON_DIR)/init_stdout.c picolibc $(SNAPSHOT_DIR)/defines.h | $(BUILD_DIR)
	$(GCC_PREFIX)-gcc $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/crt0_bl1.o: $(COMMON_DIR)/crt0_bl1.s $(SNAPSHOT_DIR)/defines.h | $(BUILD_DIR)
	$(GCC_PREFIX)-cpp $(INCS) $< > $(BUILD_DIR)/crt0_bl1.cpp.s
	$(GCC_PREFIX)-as $(CC_ABI) $(BUILD_DIR)/crt0_bl1.cpp.s -o $@

$(ELF): $(OBJS) picolibc $(LINKER_SCRIPT)
	$(GCC_PREFIX)-gcc $(LD_ABI) $(LDFLAGS) $(OBJS) -o $@
	$(GCC_PREFIX)-objdump -S -t $@ > $(BUILD_DIR)/hello_world_bl1.dis
	$(GCC_PREFIX)-nm -B -n $@ > $(BUILD_DIR)/hello_world_bl1.sym

$(BIN): $(ELF)
	$(GCC_PREFIX)-objcopy -O binary $< $@
	@echo "BL1 flat binary: $@ ($$(stat -f%z $@ 2>/dev/null || stat -c%s $@) bytes)"

clean:
	rm -rf $(BUILD_DIR)
