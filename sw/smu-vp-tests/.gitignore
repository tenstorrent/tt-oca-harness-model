# Build artifacts
*.o
*.dump
*.sym
*.log

# Compiled firmware halves.  Each test's smc.mk / sep.mk builds
# TARGET = smu_<name>_smc / smu_<name>_sep (underscored) so the binary
# never collides with the hyphenated smu-<name>-test/ source directory.
smu_*_smc
smu_*_sep

# ROM-only boot test: the SMC boot ROM image and the SMC ini generated to load it.
smu-rom-boot-test/smu_rom_boot.elf
smu-rom-boot-test/smu_rom_boot.bin
smu-rom-boot-test/smc.ini
