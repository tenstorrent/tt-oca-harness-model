CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_NS16550=y
CONFIG_UART_NS16550_ACCESS_WORD_ONLY=y
CONFIG_XIP=n
CONFIG_RISCV_PMP=n
CONFIG_MP_MAX_NUM_CPUS=1
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=100000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=100
CONFIG_PRINTK=y
CONFIG_EARLY_CONSOLE=y
CONFIG_EMPTY_IRQ_SPURIOUS=y
# Polling UART: the SMC PLIC claim path is not yet reliable for the
# ns16550 ETBEI/ERBFI interrupts the irq-driven shell enables.
CONFIG_UART_INTERRUPT_DRIVEN=n
