# =============================================================================
# sw/smc-vp-tests/Makefile.common
#
# Shared build/run rules for bare-metal RV64 firmware tests that run on the
# `smc-vp` executable (vp/platform/smc).  Mirrors the shape of
# sw/sep-vp-tests/Makefile.common, adapted for the SMC Rocket cluster:
#   - RV64 / lp64 (the SMC CPU is a 64-bit Rocket)
#   - firmware linked at 0x80000000 (cluster fast-mem window)
#   - `make sim` runs `smc-vp <ini> <elf>`
#
# Per-test Makefiles set SRCS / OBJS / TARGET and `include ../Makefile.common`.
# =============================================================================

# Toolchain
RISCV_PREFIX ?= riscv64-unknown-elf-
CC      = $(RISCV_PREFIX)gcc
OBJCOPY = $(RISCV_PREFIX)objcopy
OBJDUMP = $(RISCV_PREFIX)objdump

# Architecture — rv64imac. No FP needed for these bare-metal tests; the Rocket
# cluster emulates the superset.
#
# The -march string cannot be hard-coded: the two toolchain generations in CI
# want opposite spellings, and common/start.S needs CSR access (mhartid/mtvec).
#   - Toolchains implementing ISA-manual 20191213+ split Zicsr out of the "I"
#     base, so plain "rv64imac" rejects csrr/csrw with
#     "unrecognized opcode ... extension `zicsr' required".  The xpack
#     riscv-none-elf GCC 13/14 used by the RHEL CI job behaves this way.
#   - Older toolchains -- notably Ubuntu's apt "gcc-riscv64-unknown-elf" used
#     by .github/workflows/ci.yml -- predate the multi-letter "_zicsr" -march
#     syntax entirely and fail with "cc1: error: unsupported ISA subset 'z'",
#     but accept csrr/csrw under plain "rv64imac" because Zicsr is implied.
# Probe the toolchain instead of guessing: take the first candidate that both
# is accepted as an -march string and actually assembles a CSR instruction.
# Override with `make ARCH=...` if you need a specific string.
ABI  = lp64

ARCH_CANDIDATES ?= rv64imac_zicsr_zifencei rv64imac
ifeq ($(origin ARCH),undefined)
ARCH := $(shell for a in $(ARCH_CANDIDATES); do \
                  printf 'csrr t0, mhartid\n' | \
                    $(CC) -march=$$a -mabi=$(ABI) -x assembler-with-cpp - \
                          -c -o /dev/null >/dev/null 2>&1 && { echo $$a; break; }; \
                done)
endif
ifeq ($(strip $(ARCH)),)
$(error No usable -march found for $(CC): none of "$(ARCH_CANDIDATES)" both \
        compile and assemble a CSR instruction. Check the RISC-V toolchain.)
endif

# Common include paths — shared helpers + SMC peripheral base addresses.
SMC_VP_TESTS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
COMMON_INCS = -I$(SMC_VP_TESTS_DIR)common

# Compiler flags
CFLAGS  = -march=$(ARCH) -mabi=$(ABI) -mcmodel=medany -mno-relax
CFLAGS += -O0 -g
CFLAGS += -Wall -Wextra
CFLAGS += -ffreestanding -nostdlib -nostartfiles
CFLAGS += $(COMMON_INCS)
CFLAGS += $(EXTRA_CFLAGS)

# Linker flags
LDFLAGS += -march=$(ARCH) -mabi=$(ABI) -mcmodel=medany -mno-relax
LDFLAGS += -nostdlib -nostartfiles
LDFLAGS += -Wl,--no-relax,--print-memory-usage

# VP invocation.  VP / VP_FLAGS overridable so a developer can point at a
# non-default build tree (e.g. vp/build_smc/bin/smc-vp during bring-up).
VP        ?= ../../../vp/build/bin/smc-vp
VP_FLAGS  ?= ../../../vp/platform/smc/config/smc_platform_vp.ini
SIM_TIME_MS ?= 50

.PHONY: all clean sim dump

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ -lgcc

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	$(CC) $(CFLAGS) -c -o $@ $<

dump: $(TARGET)
	$(OBJDUMP) -D $(TARGET) > $(TARGET).dump
	$(OBJDUMP) -t $(TARGET) > $(TARGET).sym

# Run the firmware on smc-vp.  The VP runs a bounded simulation window
# (SIM_TIME_MS) then exits; the firmware prints PASS/FAIL to UART0.
sim: $(TARGET)
	$(VP) $(VP_FLAGS) $(TARGET) $(SIM_TIME_MS)

clean:
	rm -f $(OBJS) $(TARGET) $(TARGET).dump $(TARGET).sym
